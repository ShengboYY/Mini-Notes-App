{
  "name": "mini-notes-anna-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "anna:validate": "anna-app validate --strict",
    "anna:dev": "anna-app dev --no-llm",
    "anna:executa:mock": "anna-app executa dev --dir executas/notes-summarizer --mock-sampling fixtures/sampling.jsonl --invoke summarize --args '{\"notes\":[\"Follow up with the client\",\"Fix the login bug\"]}'",
    "test:protocol": "python3 scripts/protocol_test.py"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@anna-ai/cli": "0.1.49",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
