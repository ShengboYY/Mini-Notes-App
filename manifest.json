{
  "schema": 2,
  "permissions": [
    "tools.invoke",
    "storage.read",
    "storage.write"
  ],
  "required_executas": [
    {
      "tool_id": "tool-dev-notes-summarizer"
    }
  ],
  "tags": ["notes", "productivity", "sampling"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Mini Notes",
        "default": true,
        "default_size": { "w": 1100, "h": 760 },
        "min_size": { "w": 720, "h": 520 },
        "resizable": true
      }
    ],
    "host_api": {
      "tools": ["tool-dev-notes-summarizer"],
      "storage": ["get", "set"]
    },
    "csp_overrides": {},
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}
